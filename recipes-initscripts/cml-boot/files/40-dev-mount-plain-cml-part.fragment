if [ ! -e "/dev/tpm0" ]; then
	echo "Mounting CML partition in development build"
	mkdir -p /mnt/

	# On slow storage / under load the udev by-label symlink for the data
	# partition may not exist yet; wait for it before mounting (scan_devices
	# nudges udev between attempts).
	data_label_ready() { [ -e /dev/disk/by-label/gyroidos ] || [ -e /dev/disk/by-label/trustme ]; }
	wait_for "data partition (LABEL=gyroidos/trustme)" 10 scan_devices data_label_ready

	if [ -e /dev/disk/by-label/gyroidos ]; then
		mount /dev/disk/by-label/gyroidos /mnt -t ext4 -o nosuid,nodev,noexec
	else
		mount /dev/disk/by-label/trustme /mnt -t ext4 -o nosuid,nodev,noexec
	fi
	if ! mountpoint -q /mnt; then
		echo "FATAL: failed to mount CML data partition on /mnt"
		exit 1
	fi
fi


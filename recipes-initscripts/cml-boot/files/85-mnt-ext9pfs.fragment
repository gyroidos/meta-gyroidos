##############DBG###################
sleep 2
mkdir -p /data/extcmld
echo "[initramfs] Mounting /data/cmld 9pfs"
# dev hot-swap: the 9p backend is optional (absent on non-VM boots), so mounting
# it is a handled branch; the binary copies within it, however, are critical
if mount -t 9p -o trans=virtio,version=9p2000.L extcmld /data/extcmld; then
	for _bin in cmld control scd tpm2d rattestation cml-service-container; do
		if [ -f "/data/extcmld/$_bin" ]; then
			cp -f "/data/extcmld/$_bin" "/usr/sbin/$_bin"
			echo "[initramfs] Copied new $_bin to /usr/sbin"
		fi
	done
	echo "[initramfs] Unmounting extcmld"
	umount /data/extcmld
else
	echo "[initramfs] extcmld 9pfs not available"
fi
####################################

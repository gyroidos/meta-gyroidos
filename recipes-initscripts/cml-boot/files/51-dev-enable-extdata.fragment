mkdir -p /mnt/extdata
if mount LABEL=extdata -o nosuid,nodev,noexec /mnt/extdata; then
	mkdir -p /mnt/extdata/workdir
	mkdir -p /mnt/extdata/data
	if ! mount -t overlay overlay -o lowerdir=/mnt/userdata,upperdir=/mnt/extdata/data,workdir=/mnt/extdata/workdir /data; then
		echo "WARN: Failed to mount external data as overlayfs"
		mount -o bind,nosuid,nodev,noexec /mnt/userdata /data
	fi
else
	echo "No extdata fs supplied"
	mount -o bind,nosuid,nodev,noexec /mnt/userdata /data
fi
